#!/bin/sh
# Open the live player in Google Chrome.
# usage: bin/live [speed] [--labels] [--review] [--t 3m10s] [--project <folder>]
#   --review : click tiles to flag them; the panel on the right lists flags (Copy list / Download flags.txt)
#   --labels : filename and date on every tile, row/chapter/time per row
#   --t 3m10s: start at that point in the loop
# Keys: F fullscreen, space pause, [ and ] speed -/+ 10 px/s.
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export PATH="$ROOT/../tools/node/bin:$PATH"
SPEED=""; LABELS=""; START=""; REVIEW=""
while [ $# -gt 0 ]; do
  case "$1" in
    --labels) LABELS=1 ;;
    --review) REVIEW=1 ;;
    --t) shift; START="$1" ;;
    --project) shift; export SLIDESHOW_PROJECT="$1" ;;
    *) SPEED="$1" ;;
  esac; shift
done
BUILD="$(node "$ROOT/lib/common.js" --print build)" || { echo "could not resolve the project folder; pass --project <folder> or set SLIDESHOW_PROJECT" >&2; exit 1; }
# review mode uses its own file: macOS `open` strips the query string from file:// URLs, so nothing may depend on ?review=1
if [ -n "$REVIEW" ]; then PAGE="$BUILD/player-review.html"; else PAGE="$BUILD/player.html"; fi
[ -f "$PAGE" ] || { echo "$PAGE missing; run bin/build first" >&2; exit 1; }
Q=""
[ -n "$SPEED" ] && Q="$Q&speed=$SPEED"
[ -n "$LABELS" ] && Q="$Q&labels=1"
[ -n "$START" ] && Q="$Q&t=$START"
URL="file://$PAGE"
[ -n "$Q" ] && URL="$URL?${Q#&}"
echo "opening $URL"
[ -n "$REVIEW" ] && echo "review mode: click a tile to flag it, shift-click to add a note, then use 'Download flags.txt' (lands in ~/Downloads)."
CHROME="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
if [ -x "$CHROME" ]; then
  # the binary keeps the query string and hands the URL to a running Chrome
  "$CHROME" "$URL" >/dev/null 2>&1 &
elif command -v google-chrome >/dev/null 2>&1; then
  google-chrome "$URL" >/dev/null 2>&1 &
elif command -v xdg-open >/dev/null 2>&1; then
  xdg-open "$URL"
else
  open -a "Google Chrome" "$URL"
fi
