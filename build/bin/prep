#!/bin/sh
# Thin wrapper: puts the project-local toolchain (tools/node, tools/ffmpeg) on PATH and runs lib/prep.js
set -e
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export PATH="$ROOT/tools/node/bin:$ROOT/tools/ffmpeg:$PATH"
# caffeinate -i keeps the Mac from idle-sleeping while this runs (it sleeps after 1 idle minute otherwise)
if command -v caffeinate >/dev/null 2>&1; then exec caffeinate -i node "$ROOT/lib/prep.js" "$@"; fi
exec node "$ROOT/lib/prep.js" "$@"
